# Copy to .env for local development. Never commit the real .env file.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
# Omit DATABASE_URL to use instance/ecu_dashboard.db (SQLite).
# DATABASE_URL=postgresql+psycopg://ecu_user:replace-password@localhost:5432/ecu_dashboard
MAX_CONTENT_LENGTH=2097152
MAX_LOG_RECORDS=1000
RAW_FRAME_MAX_BYTES=16384
# Leave REDIS_URL empty for local one-process memory fallback, or set redis://localhost:6379/0.
# Docker Compose supplies redis://redis:6379/0 and requires Redis for production.
REDIS_URL=
LIVE_REDIS_REQUIRED=
LIVE_SAMPLE_TTL_SECONDS=15
LIVE_RATE_LIMIT_PER_SECOND=5
LIVE_RATE_LIMIT_BURST=10
LIVE_MAX_REQUEST_BYTES=4096
LIVE_SSE_HEARTBEAT_SECONDS=15
LIVE_RAW_FRAME_MAX_CHARS=256
CONTROL_POLL_STALE_SECONDS=10
ML_API_BASE_URL=
ML_API_TIMEOUT_SECONDS=2.5
ML_MODEL_NAME=Isolation Forest
ML_MODEL_VERSION=
ML_TRAINING_DATA_VERSION=
ML_FEATURE_SCHEMA_VERSION=
ML_DETECTION_THRESHOLD=
PAIRING_CODE_TTL_SECONDS=900
PAIRING_MAX_ATTEMPTS=10
TRUST_PROXY=false
TRUSTED_HOSTS=
SESSION_COOKIE_SECURE=false
GEMINI_API_KEY=
DEVICE_ID=
DEVICE_TOKEN=

# Used by docker-compose.yml
POSTGRES_DB=ecu_dashboard
POSTGRES_USER=ecu_user
POSTGRES_PASSWORD=replace-with-a-strong-password
