# Copy to .env for local development. Never commit the real .env file.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
# Omit DATABASE_URL to use instance/ecu_dashboard.db (SQLite).
# DATABASE_URL=postgresql+psycopg://ecu_user:replace-password@localhost:5432/ecu_dashboard
MAX_CONTENT_LENGTH=2097152
MAX_LOG_RECORDS=1000
SESSION_COOKIE_SECURE=false
GEMINI_API_KEY=
DEVICE_ID=
DEVICE_TOKEN=

# Used by docker-compose.yml
POSTGRES_DB=ecu_dashboard
POSTGRES_USER=ecu_user
POSTGRES_PASSWORD=replace-with-a-strong-password
